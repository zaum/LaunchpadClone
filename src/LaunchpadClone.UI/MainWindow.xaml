<Window x:Class="LaunchpadClone.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:LaunchpadClone.UI"
        Title="Launchpad" WindowStyle="None" AllowsTransparency="False"
        Background="Black" WindowState="Maximized" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="True"
         FontFamily="Segoe UI Variable Display, Segoe UI"
         PreviewMouseLeftButtonDown="OnMouseLeftButtonDown" PreviewMouseLeftButtonUp="OnMouseLeftButtonUp"
        PreviewMouseMove="OnMouseMove"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseWheel="OnPreviewMouseWheel">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Fully chromeless TextBox: no focus rectangle, no themed border,
             no "punched-out" background — text floats on its parent's fill.
             Used by the search box and the folder name field. -->
        <Style x:Key="ChromelessTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared ✕ badge look; the Button instance picks the color.
             The glyph is Segoe Fluent "ChromeClose" — same icon font
             family as the rest of the chrome (QuickLook-style). -->
        <ControlTemplate x:Key="BadgeTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="11">
                <TextBlock Text="&#xE8BB;" Foreground="White" FontSize="9"
                           FontFamily="{StaticResource SegoeFluent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </ControlTemplate>

        <Style x:Key="AnimatedDeleteBadgeStyle" TargetType="Button">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.25" ScaleY="0.25" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Setter Property="Opacity" Value="1" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.14" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.05" To="1" Duration="0:0:0.46">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.9" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.05" To="1" Duration="0:0:0.46">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.9" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="BorderBrush" Value="#18FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="CornerChoiceButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#DFFFFFFF" />
            <Setter Property="Background" Value="#08FFFFFF" />
            <Setter Property="BorderBrush" Value="#18FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#18FFFFFF" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#38FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One app tile: sized from the window's live grid-size settings.
             RenderOptions: the FLIP-glide animates RenderTransforms every
             frame during a drag — EdgeMode Aliased keeps edges crisp while
             moving (no per-frame AA shimmer), HighQuality bitmap scaling
             keeps downscaled icons sharp. -->
        <DataTemplate x:Key="AppTileTemplate">
            <Grid Width="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                  CacheMode="BitmapCache" ContextMenuOpening="OnAppContextMenuOpening"
                  ContextMenuClosing="OnAppContextMenuClosing">
                <Grid.ToolTip>
                    <ToolTip>
                        <ToolTip.Template>
                            <ControlTemplate TargetType="ToolTip">
                                <Border Background="#2A2B32" CornerRadius="6" Padding="10,6" BorderThickness="0">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </ToolTip.Template>
                        <TextBlock Text="{Binding DisplayName}" FontSize="13" Foreground="#E8E9EE" />
                    </ToolTip>
                </Grid.ToolTip>
                <Grid.ContextMenu>
                    <ContextMenu Background="#222329" Foreground="White" BorderThickness="0">
                        <MenuItem Header="Open folder" Click="OnOpenAppFolder"
                                  Background="#222329" Foreground="White" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <StackPanel>
                    <Image Source="{Binding Icon}"
                           Width="{Binding TileIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           Height="{Binding TileIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding DisplayName}" Margin="0,10,0,0"
                               FontSize="12.5" Foreground="#F2F3F7"
                               TextTrimming="CharacterEllipsis" TextAlignment="Center"
                               MaxWidth="{Binding LabelMaxWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
                <!-- Remove-from-group badge (inside an open group). -->
                <Button Click="OnRemoveFromGroup" ToolTip="Remove from group" Cursor="Hand"
                        Background="#CC444444" Template="{StaticResource BadgeTemplate}"
                        Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Visibility="{Binding ShowRemoveBadge, Converter={StaticResource BoolToVisibility}}" />
                <!-- Uninstall badge (jiggle mode). -->
                <Button Click="OnUninstallClick" ToolTip="Uninstall" Cursor="Hand"
                        Style="{StaticResource AnimatedDeleteBadgeStyle}"
                        Background="#CCC0392B" Template="{StaticResource BadgeTemplate}"
                        Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Visibility="{Binding ShowUninstallBadge, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>
        <!-- A folder stays in the main flow. Clicking it expands the same
             item to a 2x2-cell panel, so the WrapPanel moves later tiles. -->
        <DataTemplate x:Key="GroupTileTemplate">
            <Grid x:Name="GroupTileRoot">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Width" Value="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter Property="Width" Value="{Binding ExpandedWidth}" />
                                <Setter Property="MinHeight" Value="{Binding ExpandedHeight}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel x:Name="CollapsedFolder">
                    <Border Width="{Binding TileIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                            Height="{Binding TileIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                            CornerRadius="14" Background="#2EFFFFFF" Padding="13"
                            CacheMode="BitmapCache">
                        <UniformGrid Rows="3" Columns="3">
                            <Image Source="{Binding Previews[0]}" Margin="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Previews[1]}" Margin="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Previews[2]}" Margin="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Previews[3]}" Margin="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Previews[4]}" Margin="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Previews[5]}" Margin="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Previews[6]}" Margin="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Previews[7]}" Margin="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Previews[8]}" Margin="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </UniformGrid>
                    </Border>
                    <TextBlock Text="{Binding DisplayName}" Margin="0,10,0,0"
                               FontSize="12.5" Foreground="#F2F3F7"
                               TextTrimming="CharacterEllipsis" TextAlignment="Center"
                               MaxWidth="{Binding LabelMaxWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                               ToolTip="{Binding DisplayName}" />
                </StackPanel>

                <Border x:Name="ExpandedFolder" Visibility="Collapsed"
                        Background="#2EFFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1"
                        CornerRadius="16" Padding="18" Opacity="0"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="ExpandedFolderScale" ScaleX="0.82" ScaleY="0.82" />
                    </Border.RenderTransform>
                    <StackPanel>
                        <Grid Margin="2,0,2,12">
                            <TextBox Text="{Binding DisplayName, Mode=OneWay}"
                                     Style="{StaticResource ChromelessTextBox}"
                                     Foreground="White" FontSize="13" FontWeight="SemiBold"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center" Cursor="IBeam"
                                     ToolTip="Click to rename"
                                     PreviewMouseLeftButtonDown="OnInlineGroupNameMouseDown"
                                     LostKeyboardFocus="OnInlineGroupNameLostFocus"
                                     KeyDown="OnInlineGroupNameKeyDown" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding VisibleMembers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Tag="InlineGroupMember"
                                            Width="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Margin="4,6" Padding="5" CornerRadius="10"
                                            BorderThickness="1" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsKeyboardSelected}" Value="True">
                                                        <Setter Property="Background" Value="#346C8CFF" />
                                                        <Setter Property="BorderBrush" Value="#887C9CFF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Image Source="{Binding Icon}"
                                                   Width="{Binding TileIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Height="{Binding TileIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   HorizontalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding DisplayName}" Margin="0,5,0,0"
                                                       Foreground="#EFFFFFFF" FontSize="12.5"
                                                       TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding MemberPages}" Margin="0,7,0,0"
                                      HorizontalAlignment="Center"
                                      Visibility="{Binding HasMultipleMemberPages, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Index}" Click="OnGroupMemberPageClick"
                                            Width="18" Height="16" Padding="4" Margin="1,0"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Ellipse Width="7" Height="7">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#58FFFFFF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Fill" Value="#FF7C9CFF" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Delete-group badge (jiggle mode). -->
                <Button Click="OnRemoveGroupClick" ToolTip="Delete group" Cursor="Hand"
                        Style="{StaticResource AnimatedDeleteBadgeStyle}"
                        Background="#CCC0392B" Template="{StaticResource BadgeTemplate}"
                        Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Visibility="{Binding ShowRemoveBadge, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="CollapsedFolder" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ExpandedFolder" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ExpandedFolder" Property="Opacity" Value="1" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ExpandedFolder"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.22" />
                                <DoubleAnimation Storyboard.TargetName="ExpandedFolderScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 From="0.82" To="1" Duration="0:0:0.38">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.38" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ExpandedFolderScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 From="0.82" To="1" Duration="0:0:0.38">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.38" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter TargetName="ExpandedFolder" Property="Background" Value="#467C9CFF" />
                    <Setter TargetName="ExpandedFolder" Property="BorderBrush" Value="#CC9CB2FF" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <local:TileTemplateSelector x:Key="TileSelector"
                                    AppTemplate="{StaticResource AppTileTemplate}"
                                    GroupTemplate="{StaticResource GroupTileTemplate}" />
        <!-- Shared tile container style: hover highlight + macOS-style
             "accept the drop" press effect (named container so a drag
             hovering over a tile can gently scale it up). -->
        <Style x:Key="TileItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,12" />
            <!-- An expanded folder makes its WrapPanel row taller. Keep the
                 neighboring tile containers at their own desired height so
                 their hover background never stretches to folder height. -->
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="14" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#346C8CFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#887C9CFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Fullscreen scrim over the (blurred) desktop: macOS-launcher look.
         Two stacked layers: RootScrim (normal) and ScrimDim (extra dim that
         fades in behind an open folder — macOS dims the backdrop, the folder
         itself is a lighter rounded panel floating above). -->
    <Border x:Name="RootScrim" Background="#9E000000">
        <Grid>
            <!-- Static blurred desktop snapshot (captured once before the
                 window paints): zero per-frame blur cost. -->
            <Image x:Name="BackdropImage" Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Opacity="0.38" IsHitTestVisible="False" />
            <Border x:Name="ScrimDim" Background="#50000000" Opacity="0" IsHitTestVisible="False" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top-center search field -->
            <Border HorizontalAlignment="Center" Margin="0,48,0,8" Width="520"
                    Background="#33FFFFFF" CornerRadius="12" Padding="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="1" Opacity="0.35" />
                </Border.Effect>
                <Grid>
                    <!-- Segoe Fluent Search glyph, macOS-Spotlight style. -->
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource SegoeFluent}"
                               FontSize="15" Foreground="#66FFFFFF" Margin="14,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBox x:Name="SearchBox" Height="40" FontSize="15" Margin="40,0,44,0"
                             Style="{StaticResource ChromelessTextBox}"
                             Foreground="#FFFFFF" VerticalContentAlignment="Center" />
                    <TextBlock Text="Search" FontSize="15" Margin="44,0,44,0" Foreground="#59FFFFFF"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="ClearSearchButton" Text="&#xE711;" ToolTip="Clear search"
                               FontFamily="{StaticResource SegoeFluent}"
                               Cursor="Hand" FontSize="13" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Margin="0,0,16,0" Foreground="#CCFFFFFF"
                               MouseLeftButtonUp="OnClearSearch">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

                      <!-- Settings gear (top-right corner): Segoe Fluent
                           Icons Settings glyph — same Windows 11 icon system
                           the QuickLook project uses. -->
            <Button x:Name="SettingsGearButton" Click="OnOpenSettings" ToolTip="Settings" Cursor="Hand"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,48,48,0"
                    Width="40" Height="40"
                    Background="Transparent" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="Transparent">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource SegoeFluent}"
                                       FontSize="20" Foreground="#8CFFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Paged grid; PageSlide drives the soft page-flip animation.
                 Custom mouse-ghost drag only (no Ole DragDrop). -->
            <Grid Grid.Row="1" Margin="40,12,40,0" ClipToBounds="True">
                <ListBox x:Name="AppsList"
                         Background="Transparent" BorderThickness="0"
                         Focusable="False" FocusVisualStyle="{x:Null}"
                         ItemTemplateSelector="{StaticResource TileSelector}"
                         ItemContainerStyle="{StaticResource TileItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.RenderTransform>
                        <TranslateTransform x:Name="PageSlide" />
                    </ListBox.RenderTransform>
                </ListBox>
                <Image x:Name="OutgoingPageSnapshot" Visibility="Collapsed"
                       IsHitTestVisible="False" Stretch="Fill" Panel.ZIndex="5">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="OutgoingPageSlide" />
                    </Image.RenderTransform>
                </Image>
            </Grid>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,28">
                <!-- Page indicator dots; they brighten on flips and fade back. -->
                <StackPanel x:Name="PageDots" Orientation="Horizontal"
                            HorizontalAlignment="Center" Opacity="0.45" />
                <TextBlock x:Name="StatusText" Text="Starting..."
                           Visibility="Collapsed" HorizontalAlignment="Center" Margin="0"
                           Foreground="#80FFFFFF" FontSize="12" />
            </StackPanel>
            <!-- Drag ghost for icon drag (grouping / reorder / drag-out).
                 The icon slides on a TranslateTransform updated per frame
                 (Margin moved the layout box every mouse-move — the cause of
                 the jittery drag), with a soft macOS-style pop on pickup. -->
            <Border x:Name="DragGhost" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                    IsHitTestVisible="False" Visibility="Collapsed" Panel.ZIndex="30"
                    Width="{Binding TileIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                    Height="{Binding TileIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                    Background="Transparent" Padding="0"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="DragGhostScale" />
                        <!-- Translation must come after scale so the pickup
                             zoom never scales the cursor coordinates. -->
                        <TranslateTransform x:Name="DragGhostSlide" />
                    </TransformGroup>
                </Border.RenderTransform>
                <Image x:Name="DragGhostImage" Stretch="Uniform" />
            </Border>

            <!-- Open group ("folder") view — macOS Launchpad style:
                 the backdrop stays blurred (an extra dim fades in), and the
                 folder is a lighter, rounded translucent panel that zooms
                 open from the folder tile and slides in its member icons. -->
            <Grid x:Name="GroupOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="20"
                  Background="Transparent" Visibility="Collapsed">
                <!-- Opaque dark card (Fluent "smoke" acrylic tone): solid, so
                     member icons never fight the busy grid shining through.
                     Positioned at the folder tile's screen spot via Margin
                     (OpenGroup measures the tile) — macOS opens the folder
                     where you created/clicked it. -->
                <Border x:Name="GroupCard" Background="#F2262B33" CornerRadius="26"
                        Padding="40,26,40,22" MaxWidth="860"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.45" />
                    </Border.Effect>
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="GroupCardScale" ScaleX="0.86" ScaleY="0.86" />
                    </Border.RenderTransform>
                    <StackPanel>
                        <StackPanel Margin="0,0,0,18">
                            <Border Width="430" Height="44" Background="#14FFFFFF"
                                    BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource SegoeFluent}"
                                               Foreground="#8FFFFFFF" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBox x:Name="GroupNameBox" Grid.Column="1" FontSize="18"
                                             Style="{StaticResource ChromelessTextBox}"
                                             TextAlignment="Center" Foreground="White"
                                             VerticalContentAlignment="Center" />
                                    <Button Grid.Column="2" Content="Save" Click="OnSaveGroupName"
                                            Margin="6" Padding="10,0" Cursor="Hand"
                                            Background="#356C8CFF" Foreground="White"
                                            BorderBrush="#557C9CFF" BorderThickness="1" />
                                </Grid>
                            </Border>
                            <TextBlock Text="Edit the title, then press Enter or Save"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                       Foreground="#72FFFFFF" FontSize="11" />
                        </StackPanel>
                        <ListBox x:Name="GroupMembers" Background="Transparent" BorderThickness="0"
                                 ItemTemplate="{StaticResource AppTileTemplate}"
                                 ItemContainerStyle="{StaticResource TileItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.RenderTransform>
                                <TranslateTransform x:Name="GroupMembersSlide" />
                            </ListBox.RenderTransform>
                        </ListBox>
                        <TextBlock Text="click/Enter — launch · drag out — remove · Esc — close"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"
                                   Foreground="#99FFFFFF" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
            <!-- Settings panel (gear / Done to close) -->
            <Border x:Name="SettingsOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="40"
                    Background="#B5000000" Visibility="Collapsed">
                <Border Width="560" Background="#F51B1D24" CornerRadius="22" Padding="28"
                        BorderBrush="#24FFFFFF" BorderThickness="1"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="42" ShadowDepth="0" Opacity="0.55" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="12" Background="#286C8CFF">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource SegoeFluent}"
                                           Foreground="#D8FFFFFF" FontSize="16" FontWeight="Light"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Launchpad Settings" FontSize="21" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Changes are saved automatically" FontSize="11" Foreground="#78FFFFFF" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="HOT CORNER" Foreground="#8FA6C8FF"
                                                   FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Text="Open Launchpad by touching a screen corner"
                                                   Foreground="#AFFFFFFF" FontSize="12" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="HotCornerToggle"
                                                     HorizontalAlignment="Right" VerticalAlignment="Center"
                                                     Checked="OnHotCornerToggled" Unchecked="OnHotCornerToggled" />
                                </Grid>
                                <Border Width="138" Height="84" Margin="0,14,0,0"
                                        HorizontalAlignment="Center" CornerRadius="13"
                                        Background="#09000000" BorderBrush="#40FFFFFF" BorderThickness="2">
                                    <Grid>
                                        <Border Margin="12" CornerRadius="7" Background="#08FFFFFF"
                                                BorderBrush="#16FFFFFF" BorderThickness="1" />
                                        <Button x:Name="TopLeftCornerButton" Tag="TopLeft" Click="OnCornerClick"
                                                Style="{StaticResource CornerChoiceButtonStyle}"
                                                Width="30" Height="30" Margin="-2" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="↖" FontSize="15" />
                                        </Button>
                                        <Button x:Name="TopRightCornerButton" Tag="TopRight" Click="OnCornerClick"
                                                Style="{StaticResource CornerChoiceButtonStyle}"
                                                Width="30" Height="30" Margin="-2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="↗" FontSize="15" />
                                        </Button>
                                        <Button x:Name="BottomLeftCornerButton" Tag="BottomLeft" Click="OnCornerClick"
                                                Style="{StaticResource CornerChoiceButtonStyle}"
                                                Width="30" Height="30" Margin="-2" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                            <TextBlock Text="↙" FontSize="15" />
                                        </Button>
                                        <Button x:Name="BottomRightCornerButton" Tag="BottomRight" Click="OnCornerClick"
                                                Style="{StaticResource CornerChoiceButtonStyle}"
                                                Width="30" Height="30" Margin="-2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <TextBlock Text="↘" FontSize="15" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="ICON SIZE" Foreground="#8FA6C8FF" FontSize="11" FontWeight="SemiBold" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="GridSizePopup" HorizontalAlignment="Left"
                                               Foreground="White" FontSize="13" FontWeight="SemiBold"
                                               Margin="0,0,0,5" IsHitTestVisible="False" />
                                    <Slider x:Name="TileScaleSlider" Grid.Row="1" Minimum="70" Maximum="140"
                                            VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="5"
                                            TickPlacement="None" ValueChanged="OnTileScaleChanged"
                                            Loaded="OnSliderLoaded" />
                                </Grid>
                                <Grid Margin="0,3,0,0">
                                    <TextBlock Text="Compact" Foreground="#68FFFFFF" FontSize="10" />
                                    <TextBlock Text="Large" Foreground="#68FFFFFF" FontSize="10" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="KEYBOARD SHORTCUT" Foreground="#8FA6C8FF" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="Press a key combination to open Launchpad from anywhere"
                                           Foreground="#AFFFFFFF" FontSize="12" Margin="0,4,0,10" />
                                <ui:TextBox x:Name="HotKeyBox" Height="40" FontSize="14"
                                            PlaceholderText="Press keys, for example Ctrl+Alt+L"
                                            VerticalContentAlignment="Center"
                                            KeyDown="OnHotKeyBoxKeyDown" LostFocus="OnHotKeyBoxCommit" />
                            </StackPanel>
                        </Border>

                        <ui:Button x:Name="DoneButton" Content="Done" Click="OnCloseSettings" Cursor="Hand"
                                   Width="116" Height="38" Margin="0,8,0,0" HorizontalAlignment="Right"
                                   Appearance="Primary" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
        </Grid>
    </Border>
</Window>
