<Window x:Class="LaunchpadClone.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LaunchpadClone.UI"
        Title="Launchpad" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowState="Maximized" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="True"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        AllowDrop="True"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseMove="OnMouseMove"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseWheel="OnPreviewMouseWheel">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Shared ✕ badge look; the Button instance picks the color. -->
        <ControlTemplate x:Key="BadgeTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="11">
                <TextBlock Text="✕" Foreground="White" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </ControlTemplate>

        <!-- One app tile: sized from the window's live grid-size settings. -->
        <DataTemplate x:Key="AppTileTemplate">
            <Grid Width="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel>
                    <Image Source="{Binding Icon}"
                           Width="{Binding TileIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           Height="{Binding TileIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding DisplayName}" Margin="0,10,0,0"
                               FontSize="12.5" Foreground="#F2F3F7"
                               TextTrimming="CharacterEllipsis" TextAlignment="Center"
                               MaxWidth="{Binding LabelMaxWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                               ToolTip="{Binding DisplayName}" />
                </StackPanel>
                <!-- Remove-from-group badge (inside an open group). -->
                <Button Click="OnRemoveFromGroup" ToolTip="Remove from group" Cursor="Hand"
                        Background="#CC444444" Template="{StaticResource BadgeTemplate}"
                        Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Visibility="{Binding ShowRemoveBadge, Converter={StaticResource BoolToVisibility}}" />
                <!-- Uninstall badge (jiggle mode). -->
                <Button Click="OnUninstallClick" ToolTip="Uninstall" Cursor="Hand"
                        Background="#CCC0392B" Template="{StaticResource BadgeTemplate}"
                        Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Visibility="{Binding ShowUninstallBadge, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>
        <!-- Group tile: 3x3 mini grid of up to 9 member icons. -->
        <DataTemplate x:Key="GroupTileTemplate">
            <Grid Width="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel>
                    <Border Width="{Binding TileIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                            Height="{Binding TileIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                            CornerRadius="22" Background="#33FFFFFF" Padding="12">
                        <UniformGrid Rows="3" Columns="3">
                            <Image Source="{Binding Previews[0]}" Margin="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Previews[1]}" Margin="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Previews[2]}" Margin="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Previews[3]}" Margin="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Previews[4]}" Margin="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Previews[5]}" Margin="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Previews[6]}" Margin="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Previews[7]}" Margin="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Previews[8]}" Margin="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </UniformGrid>
                    </Border>
                    <TextBlock Text="{Binding DisplayName}" Margin="0,10,0,0"
                               FontSize="12.5" Foreground="#F2F3F7"
                               TextTrimming="CharacterEllipsis" TextAlignment="Center"
                               MaxWidth="{Binding LabelMaxWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                               ToolTip="{Binding DisplayName}" />
                </StackPanel>
                <!-- Delete-group badge (jiggle mode). -->
                <Button Click="OnRemoveGroupClick" ToolTip="Delete group" Cursor="Hand"
                        Background="#CCC0392B" Template="{StaticResource BadgeTemplate}"
                        Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Visibility="{Binding ShowRemoveBadge, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>

        <local:TileTemplateSelector x:Key="TileSelector"
                                    AppTemplate="{StaticResource AppTileTemplate}"
                                    GroupTemplate="{StaticResource GroupTileTemplate}" />
        <!-- Shared tile container style: hover/selection rounded highlight. -->
        <Style x:Key="TileItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="14" Padding="{TemplateBinding Padding}"
                                Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Fullscreen scrim over the (blurred) desktop: macOS-launcher look. -->
    <Border Background="#9E000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top-center search field -->
            <Border HorizontalAlignment="Center" Margin="0,48,0,8" Width="520"
                    Background="#33FFFFFF" CornerRadius="12" Padding="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="1" Opacity="0.35" />
                </Border.Effect>
                <Grid>
                    <TextBox x:Name="SearchBox" Height="40" FontSize="15" Margin="16,0"
                             Background="Transparent" BorderThickness="0" CaretBrush="#FFFFFF"
                             Foreground="#FFFFFF" VerticalContentAlignment="Center" />
                    <TextBlock Text="Search" FontSize="15" Margin="20,0,0,0" Foreground="#99FFFFFF"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

                      <!-- Settings gear (top-right corner) -->
            <Button Click="OnOpenSettings" ToolTip="Settings" Cursor="Hand"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,48,48,0"
                    Width="40" Height="40"
                    FontSize="18" Foreground="#E8E9EE" Content="⚙">
                <Button.Background>
                    <SolidColorBrush Color="Transparent" />
                </Button.Background>
            </Button>

            <!-- Paged grid; PageSlide drives the soft page-flip animation. -->
            <ListBox x:Name="AppsList" Grid.Row="1" Margin="40,12,40,0"
                     Background="Transparent" BorderThickness="0"
                     AllowDrop="True"
                     DragEnter="OnDragEnter" DragOver="OnDragOver" Drop="OnDrop"
                     ItemTemplateSelector="{StaticResource TileSelector}"
                     ItemContainerStyle="{StaticResource TileItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.RenderTransform>
                    <TranslateTransform x:Name="PageSlide" />
                </ListBox.RenderTransform>
            </ListBox>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                <!-- Page indicator dots; they brighten on flips and fade back. -->
                <StackPanel x:Name="PageDots" Orientation="Horizontal"
                            HorizontalAlignment="Center" Opacity="0.45" />
                <TextBlock x:Name="StatusText" Text="Starting..."
                           HorizontalAlignment="Center" Margin="0,8,0,20"
                           Foreground="#80FFFFFF" FontSize="12" />
            </StackPanel>
            <!-- Drag ghost for icon drag (grouping / reorder / drag-out). -->
            <Border x:Name="DragGhost" HorizontalAlignment="Left" VerticalAlignment="Top"
                    IsHitTestVisible="False" Visibility="Collapsed" Panel.ZIndex="30"
                    Background="#6616171B" CornerRadius="16" Padding="12">
                <Image x:Name="DragGhostImage" Width="64" Height="64" />
            </Border>

            <!-- Open group ("folder") view -->
            <Border x:Name="GroupOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="20"
                    Background="#E0000000" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBox x:Name="GroupNameBox" Width="360" Height="40" FontSize="18"
                             TextAlignment="Center" Background="#2EFFFFFF" Foreground="White"
                             BorderThickness="0" CaretBrush="White"
                             VerticalContentAlignment="Center" Margin="0,0,0,24" />
                    <ListBox x:Name="GroupMembers" Background="Transparent" BorderThickness="0"
                             AllowDrop="True"
                             DragEnter="OnDragEnter" DragOver="OnDragOver" Drop="OnDrop"
                             ItemTemplate="{StaticResource AppTileTemplate}"
                             ItemContainerStyle="{StaticResource TileItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <TextBlock Text="double-click/Enter — launch · drag out — remove · ✕ — remove · Esc — close"
                               HorizontalAlignment="Center" Margin="0,20,0,0"
                               Foreground="#80FFFFFF" FontSize="12" />
                </StackPanel>
            </Border>
            <!-- Settings panel (gear / Done to close) -->
            <Border x:Name="SettingsOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="40"
                    Background="#E6000000" Visibility="Collapsed">
                <Border Width="500" Background="#222329" CornerRadius="16" Padding="28"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"
                                   Foreground="White" Margin="0,0,0,20" />

                        <TextBlock Text="Hot corner" Foreground="#9AA0AE" FontSize="12" Margin="0,0,0,6" />
                        <CheckBox x:Name="HotCornerToggle"
                                  Content="Open when the mouse reaches a screen corner"
                                  Foreground="White" Checked="OnHotCornerToggled" Unchecked="OnHotCornerToggled" />
                        <UniformGrid Columns="4" Margin="0,12,0,4">
                            <Button Tag="TopLeft" Click="OnCornerClick" Cursor="Hand" Width="52" Height="52" Margin="6">
                                <Path Data="M 30,6 L 6,6 L 6,30" Stroke="White" StrokeThickness="8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                            <Button Tag="TopRight" Click="OnCornerClick" Cursor="Hand" Width="52" Height="52" Margin="6">
                                <Path Data="M 6,6 L 30,6 L 30,30" Stroke="White" StrokeThickness="8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                            <Button Tag="BottomRight" Click="OnCornerClick" Cursor="Hand" Width="52" Height="52" Margin="6">
                                <Path Data="M 6,6 L 30,6 L 30,30" Stroke="White" StrokeThickness="8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="180" />
                                    </Path.RenderTransform>
                                </Path>
                            </Button>
                            <Button Tag="BottomLeft" Click="OnCornerClick" Cursor="Hand" Width="52" Height="52" Margin="6">
                                <Path Data="M 30,6 L 6,6 L 6,30" Stroke="White" StrokeThickness="8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="180" />
                                    </Path.RenderTransform>
                                </Path>
                            </Button>
                        </UniformGrid>

                        <TextBlock Text="Grid size" Foreground="#9AA0AE" FontSize="12" Margin="0,18,0,6" />
                        <Slider x:Name="TileScaleSlider" Minimum="70" Maximum="140"
                                IsSnapToTickEnabled="True" TickFrequency="5"
                                ValueChanged="OnTileScaleChanged" />

                        <TextBlock Text="Open shortcut (e.g. Ctrl+Alt+L)" Foreground="#9AA0AE"
                                   FontSize="12" Margin="0,18,0,6" />
                        <TextBox x:Name="HotKeyBox" Height="36" FontSize="14" Background="#33FFFFFF"
                                 Foreground="White" BorderThickness="0" CaretBrush="White"
                                 VerticalContentAlignment="Center" Padding="10,0"
                                 KeyDown="OnHotKeyBoxKeyDown" LostFocus="OnHotKeyBoxCommit" />

                        <Button Content="Done" Click="OnCloseSettings" Cursor="Hand"
                                Width="110" Height="36" Margin="0,24,0,0" HorizontalAlignment="Right"
                                Background="#6C8CFF" Foreground="White" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
