<Application x:Class="LaunchpadClone.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Fluent (Windows 11) design: dark theme + control styles.
                     Custom styles below override these where the launcher
                     needs its own look (badges, tiles, slider). -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Accent color shared by selection, dots and settings highlights. -->
            <SolidColorBrush x:Key="AccentBrush" Color="#6C8CFF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
