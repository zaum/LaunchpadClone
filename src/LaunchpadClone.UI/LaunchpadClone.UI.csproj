<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- The UI consumes Core as-is: discovery, icons, cache, launch, watcher. -->
    <ProjectReference Include="..\LaunchpadClone.Core\LaunchpadClone.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fluent (Windows 11) design system for WPF: styled controls, Mica
         backdrop, dark theme resources. -->
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

</Project>
